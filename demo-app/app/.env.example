# ──────────────────────────────────────────────────────────────────────────────
# Frontend env (Vite — exposed to the browser)
# ──────────────────────────────────────────────────────────────────────────────
# These VITE_-prefixed vars are bundled into the frontend at build time.
# Copy to `.env.local` for local dev (.env.local is gitignored).
#
# When unset, the matching frontend adapter falls into a local stub mode that
# simulates network calls — useful for UI iteration without a backend.

# Supabase — per-user login + shared live data (the whole CRM syncs through a
# JSONB document in Supabase, so every signed-in user shares one dataset).
# The anon/publishable key is safe to ship in the browser bundle: every read/
# write is governed by RLS + the user's session. When BOTH are unset the app
# runs in local-only mode (no login gate, localStorage store) — handy offline.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional: override the single-org id the shared state is keyed to. Defaults to
# the seeded org (matches FORMS_ORG_ID below).
VITE_CLEANSPACE_ORG_ID=

# Twilio adapter — see app/src/lib/twilio.js
VITE_TWILIO_BACKEND_URL=

# Email adapter — see app/src/lib/email.js
# Points at the deployment backend that wraps Resend (typically a Vercel API
# route mounted at /api). Common values:
#   - dev (separate backend project):  http://localhost:8787/api
#   - prod (same Vercel project):      /api
VITE_EMAIL_BACKEND_URL=

# Push adapter — see app/src/lib/push.js
# Optional override for the push backend base. LEAVE BLANK for normal deploys:
# push.js then uses the co-located same-origin /api/push/* routes whenever
# Supabase auth is configured. Only set this if the push routes ever move to a
# separate origin. With no Supabase configured at all (local/demo), push.js runs
# in stub mode regardless (in-memory subs; the test button fires a local
# Notification on the current device).
VITE_PUSH_BACKEND_URL=

# VAPID public key for Web Push subscription. Generated once via
#   npx web-push generate-vapid-keys
# The matching private key (VAPID_PRIVATE_KEY) lives in backend env only.
# Safe to expose in the frontend bundle.
VITE_VAPID_PUBLIC_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Backend env (NOT exposed to the browser)
# ──────────────────────────────────────────────────────────────────────────────
# These are consumed by the deployment backend (Vercel API routes / Cloudflare
# Workers / etc.) that this frontend calls. They are NEVER prefixed VITE_ and
# NEVER referenced from app/src/. Put them in your hosting platform's secret
# manager — never commit a populated copy of this file.

# ── System transactional email (Resend) ────────────────────────────────────
# Resend account API key. Generate at https://resend.com/api-keys.
RESEND_API_KEY=re_your_key_here

# Verified sending subdomain (must be added + verified in Resend before sends
# leave stub mode in production). Recommended pattern is a dedicated subdomain
# such as `mail.<your-domain>` so app email reputation is isolated from
# marketing or general business email.
RESEND_VERIFIED_DOMAIN=mail.example.com

# Default From for system-originated email (invitations, reminders, billing).
# Backend validates this against RESEND_VERIFIED_DOMAIN on every send.
RESEND_DEFAULT_FROM="Your Company <hello@mail.example.com>"

# Optional Reply-To override for system emails. When unset, replies route to
# whatever Reply-To the caller passed (typically the inviter's address).
RESEND_DEFAULT_REPLY_TO=

# Inbound webhook signing secret (used in Phase 4c — verifies that inbound
# email payloads actually came from Resend, not a forger).
RESEND_INBOUND_SECRET=

# ── Per-user Connected Inboxes (Phase 3 — placeholders) ────────────────────
# Filled in once Phase 3 (per-user OAuth + SMTP) lands. Documented here so
# the deployment env stays in one place.

# Google OAuth (Gmail / Workspace) — the inbox integration's client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=

# Google Business Profile OAuth (/api/reviews). A SEPARATE client: "CleanSpace
# App - Reviews" on the Workspace-owned "GBP API Project" (gbp-api-project-498522,
# kyle@cleanspacefacilitysolutions.com), because Google's Business Profile API
# access grant + quota live on THAT project, not the Gmail client's. Internal
# audience → only @cleanspacefacilitysolutions.com accounts can consent. The
# redirect URI <APP_PUBLIC_URL>/api/reviews/oauth/callback is registered on it,
# and the four Business Profile APIs are enabled there (2026-07-31). Tokens are
# encrypted with INBOX_TOKEN_ENCRYPTION_KEY. If unset, the code falls back to
# the Gmail client — which has NO GBP quota, so consent/sync would fail: set both.
GMB_OAUTH_CLIENT_ID=
GMB_OAUTH_CLIENT_SECRET=

# ── Google Maps Platform (server-side only — NEVER prefix with VITE_) ──────
# ONE key serves three server routes:
#   /api/geo                 → Geocoding API   (site address → lat/lng for the clock-in geofence)
#   /api/settings (reviews)  → Places API      (Google review pull)
#   /api/time/drive-report   → Routes API      (computeRoutes — mapped drive time between two
#                              sites, the baseline paid drive time is judged against)
# Enable ALL THREE APIs on the key's Google Cloud project (and list them in the
# key's API restrictions if it's restricted) — a missing Routes API shows up as
# every drive leg reading "No estimate", with Google's reason in the function log.
# Routes calls are cached per site pair in drive_time_estimates, so steady-state
# usage sits inside the free monthly tier.
GOOGLE_MAPS_API_KEY=
# Place ID for the public listing the Places review card shows, and the "leave us a
# review" link. Without it the card reports "not configured" (api/_lib/constants.js
# has no fallback), so set it to the client's own listing.
GOOGLE_PLACE_ID=

# Microsoft OAuth (Outlook / 365)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Encryption key for stored tokens / SMTP passwords (32-byte random, AES-GCM).
# Generate with: `openssl rand -base64 32`
INBOX_TOKEN_ENCRYPTION_KEY=

# Public base URL of this app, used to build OAuth redirect URIs and inbound
# Reply-To addresses (e.g. reply+<conversationId>@inbound.<verified-domain>).
INBOX_INBOUND_BASE_URL=https://app.example.com

# ── Supabase (connected-inbox backend store) ───────────────────────────────
# Token store + inbound buffer for connected Gmail inboxes. Used only by the
# app/api/inbox/* serverless functions — the service-role key bypasses RLS, so
# it must never reach the browser. Schema is versioned in supabase/migrations/
# (repo root); copy these values from Supabase → Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Anon/publishable key — used by the API routes ONLY to verify a caller's
# Supabase session JWT (requireAuth on admin endpoints). Safe to expose.
SUPABASE_ANON_KEY=

# ── Forms builder ──────────────────────────────────────────────────────────
# Frontend: point the forms adapter at the API. Set to "/api" in prod (same
# Vercel project). When UNSET, forms run in a localStorage stub so the builder
# is fully testable with no backend.
VITE_FORMS_BACKEND_URL=
# Single-company org id the forms tables are scoped to (matches the seeded row
# in the forms migration). Override only if you seed a different org.
FORMS_ORG_ID=00000000-0000-0000-0000-000000000001
# Org id the shared org_state blob + push subscriptions are keyed to. IMPORTANT:
# app/api/_lib/orgState.js and the push backend read THIS var — NOT FORMS_ORG_ID
# or the frontend's VITE_CLEANSPACE_ORG_ID. If you override the org id, set ALL of
# FORMS_ORG_ID, VITE_CLEANSPACE_ORG_ID, and CLEANSPACE_ORG_ID to the same value, or the
# CRM state and push will split across two orgs (push dispatch would read an empty
# blob and silently deliver nothing). Defaults to the seeded org when unset.
CLEANSPACE_ORG_ID=00000000-0000-0000-0000-000000000001
# Internal recipient for new-submission alert emails (via Resend). Optional —
# email is skipped if unset. Reuses RESEND_API_KEY / RESEND_DEFAULT_FROM above.
FORMS_NOTIFY_EMAIL=
# Base URL used to build dashboard deep-links in submission notification emails.
# Also used by the Quotes feature (below) to build the public /quote/:token
# link that gets texted/emailed to the prospect, and the Stripe return URL.
APP_PUBLIC_URL=

# ── Quotes → e-signature (public sign links) ───────────────────────────────
# The quotes flow (app/api/quotes/* + app/api/public/pay/*) is now e-signature,
# not Pay-Now: the prospect opens the public /quote/:token link and signs the
# service agreement; a signed PDF is rendered and emailed to both sides.
#
# Reply-To on the client's signed-copy email. Falls back to the brand's company.email
# (brands/<id>/brand.json, REBRAND.md) when unset.
QUOTE_REPLY_TO=
# Internal recipient for the "quote signed" alert email (signed PDF attached).
# Falls back to QUOTE_NOTIFY_EMAIL -> FORMS_NOTIFY_EMAIL -> the brand's company.email.
# Unlike form alerts this does NOT skip when unset.
QUOTE_NOTIFY_EMAIL=
#
# ── Quotes → Stripe (LEGACY / inactive) ────────────────────────────────────
# The Pay-Now flow was replaced by e-signature; STRIPE_SECRET_KEY and
# STRIPE_WEBHOOK_SECRET currently have NO code consumers. Left here as a marker
# in case card payment is reintroduced — setting them today does nothing.
#
# Secret key from https://dashboard.stripe.com/apikeys (sk_live_… / sk_test_…).
STRIPE_SECRET_KEY=
# Signing secret for the Stripe webhook endpoint (whsec_…), from
# https://dashboard.stripe.com/webhooks. Verifies that payment events posted to
# /api/public/pay/:token/webhook genuinely came from Stripe. Only consulted in
# live mode; ignored by the stub.
STRIPE_WEBHOOK_SECRET=

# ── Web Push (mobile + desktop notifications) ──────────────────────────────
# VAPID keypair. Public key is also exposed to the frontend as
# VITE_VAPID_PUBLIC_KEY (above). Private key MUST stay server-side.
# Generate both at once: `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Subject identifier for push messages — either a `mailto:` address or an
# `https://` URL identifying the operator. Required by the Web Push spec. Falls back
# to mailto: the brand's company.email when unset.
VAPID_SUBJECT=mailto:office@example.com

# ── Scheduled jobs (Vercel Cron) ────────────────────────────────────────────
# Shared secret authenticating the platform's scheduled invocations of the cron
# routes in vercel.json: /api/push/dispatch, /api/inbox/ingest, /api/marketing/run
# (every minute) and /api/time/auto-close (hourly). Vercel Cron sends it as
# `Authorization: Bearer <secret>`. SET THIS IN PRODUCTION — two routes behave
# badly without it: /api/push/dispatch and /api/time/auto-close refuse to run
# (fail closed), while /api/inbox/ingest and /api/marketing/run fall back to
# running UNAUTHENTICATED (fail OPEN) — anyone could POST them to force sends or
# probe pipeline counts. Generate with `openssl rand -base64 32`.
CRON_SECRET=

# ── Error alerting (optional but recommended) ────────────────────────────────
# Real-time page for the app's deliberate server-side alarms — org_state
# baseline-integrity mismatch, crew_assignments sync failure, etc. (api/_lib/monitor.js).
# With this UNSET, those alarms still write a greppable `[ALERT] <tag>` line to the
# Vercel function logs but nobody is paged. Set it to a Slack or Discord incoming-webhook
# URL (or any endpoint that accepts `{ "text": "..." }`) to get real-time alerts. The
# alarm path is fire-and-forget and never blocks or fails the request it reports on.
ALERT_WEBHOOK_URL=
