      "target": "contacts",
      "kind": "scalar-id",
      "policy": "SWEEP"
    },
    "marketingSequences[].replyTags": {
      "target": "tags",
      "kind": "id-array",
      "policy": "SWEEP",
      "why": "LW-02 fix — scrubTagFromSequences"
    },
    "sites[].tagIds": {
      "target": "tags",
      "kind": "id-array",
      "policy": "SWEEP",
      "why": "DELETE_TAG scrubs sites.tagIds"
    },
    "jobs[].shiftId": {
      "target": "sites.shifts",
      "kind": "scalar-id",
      "policy": "NOT-EXERCISABLE",
      "why": "shift scheduling is unpopulated in this build (0 jobs carry shiftId, 0 site.shifts rows)"
