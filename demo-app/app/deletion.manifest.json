{
  "version": 1,
  "note": "Deletion-ripple FK law book. Hand-classified; reconciled against a mechanical enumeration by deletion-lint.mjs. Policy vocabulary: SWEEP / NULLIFY / NULLIFY+name / REPOINT / BLOCK / BLOCK-UNSETTLED / KEEP-BY-DESIGN / EXTERNAL-NOT-FK / IDENTITY / NOT-EXERCISABLE. A cell with \"nameField\" must keep the deleted person's name in that field of the same row (NULLIFY+name always has one); the harness proves it (\"+NAME\"). Disputed cells carry \"decision\".",
  "targets": {
    "users": {
      "idField": "id",
      "deletedBy": [
        "DELETE_USER"
      ],
      "guards": [
        "isLastOwner"
      ]
    },
    "clients": {
      "idField": "id",
      "deletedBy": [
        "DELETE_CLIENT"
      ]
    },
    "contacts": {
      "idField": "id",
      "altKeys": [
        "email"
      ],
      "deletedBy": [
        "DELETE_CONTACT"
      ],
      "alsoCascadedBy": [
        "DELETE_CLIENT"
      ]
    },
    "sites": {
      "idField": "id",
      "deletedBy": [],
      "note": "no standalone delete; dies with its client"
    },
    "jobs": {
      "idField": "id",
      "deletedBy": [
        "DELETE_JOB",
        "DELETE_JOB_SERIES",
        "UPDATE_JOB_SERIES"
      ]
    },
    "invoices": {
      "idField": "id",
      "deletedBy": [
        "DELETE_INVOICE"
      ]
    },
    "tags": {
      "idField": "id",
      "deletedBy": [
        "DELETE_TAG"
      ]
    },
    "keys": {
      "idField": "id",
      "deletedBy": [
        "DELETE_KEY"
      ]
    },
    "services": {
      "idField": "id",
      "deletedBy": [
        "DELETE_SERVICE"
      ]
    },
    "frequencies": {
      "idField": "id",
      "deletedBy": [
        "DELETE_FREQUENCY"
      ]
    },
    "conversations": {
      "idField": "id",
      "deletedBy": [
        "DELETE_CONVERSATION",
        "BULK_DELETE_CONVERSATIONS"
      ]
    },
    "snippets": {
      "idField": "id",
      "deletedBy": [
        "DELETE_SNIPPET"
      ]
    },
    "pipelines": {
      "idField": "id",
      "deletedBy": [
        "DELETE_PIPELINE"
      ],
      "guards": [
        "pipelineInUse"
      ]
    },
    "opportunities": {
      "idField": "id",
      "deletedBy": [
        "DELETE_OPPORTUNITY"
      ]
    },
    "supplyItems": {
      "idField": "id",
      "deletedBy": [
        "DELETE_SUPPLY_ITEM"
      ]
    },
    "supplyRequests": {
      "idField": "id",
      "deletedBy": [
        "DELETE_SUPPLY_REQUEST"
      ]
    },
    "oauthWorkspaces": {
      "idField": "id",
      "deletedBy": [
        "REMOVE_OAUTH_WORKSPACE"
      ],
      "guards": [
        "oauthWorkspaceInUse"
      ]
    },
    "marketingInboxes": {
      "idField": "id",
      "deletedBy": [
        "REMOVE_MARKETING_INBOX"
      ]
    },
    "marketingSequences": {
      "idField": "id",
      "deletedBy": [
        "DELETE_MARKETING_SEQUENCE"
      ]
    },
    "checklistTemplates": {
      "idField": "id",
      "deletedBy": [
        "SCRUB_CHECKLIST_TEMPLATE"
      ],
      "note": "Templates are relational (server inspection_templates), not a blob slice: the record itself is hard-deleted by store.deleteTemplate over /api/qc/templates/delete, and SCRUB_CHECKLIST_TEMPLATE is the reducer's anti-orphan ripple that clears the client references. Decision checklist-template-delete resolved 2026-09-24 (hard delete, no archive; history kept via inspection/checklist snapshots)."
    },
    "payrollLines": {
      "idField": "id",
      "deletedBy": [
        "DELETE_PAYROLL_LINE"
      ],
      "guards": [
        "reimbursementForLine"
      ]
    },
    "reimbursements": {
      "idField": "id",
      "deletedBy": [
        "DELETE_REIMBURSEMENT"
      ],
      "note": "takes its own pay line"
    }
  },
  "fields": {
    "$.activePipelineId": {
      "target": "pipelines",
      "kind": "scalar-id",
      "policy": "REPOINT",
      "why": "DELETE_PIPELINE reassigns activePipelineId to the master pipeline"
    },
    "$.currentUserId": {
      "target": "users",
      "kind": "scalar-id",
      "policy": "NOT-EXERCISABLE",
      "why": "session pointer to the acting user; self-delete is UI-prevented and not a data cascade",
      "decision": "self-delete"
    },
    "clients[].billingContactId": {
      "target": "contacts",
      "kind": "scalar-id",
      "policy": "NULLIFY"
    },
    "clients[].crewChecklists.{key}": {
      "target": "users",
      "kind": "map-key",
      "policy": "SWEEP",
      "why": "remove the per-cleaner checklist entry for a deleted user"
    },
    "clients[].frequencyId": {
      "target": "frequencies",
      "kind": "scalar-id",
      "policy": "NULLIFY",
      "why": "DELETE_FREQUENCY nulls clients.frequencyId"
    },
    "clients[].primaryContactId": {
      "target": "contacts",
      "kind": "scalar-id",
      "policy": "NULLIFY"
    },
    "clients[].serviceId": {
      "target": "services",
      "kind": "scalar-id",
      "policy": "NULLIFY",
      "why": "DELETE_SERVICE nulls clients.serviceId"
    },
    "clients[].supervisorId": {
      "target": "users",
      "kind": "scalar-id",
      "policy": "NULLIFY",
      "why": "a dangling-but-truthy supervisorId strands the account off the \"needs a manager\" bench (DEL-01a)"
    },
    "clients[].tagIds": {
      "target": "tags",
      "kind": "id-array",
      "policy": "SWEEP",
      "why": "DELETE_TAG scrubs the tag id"
    },
    "connectedInboxes[].userId": {
      "target": "users",
      "policy": "SWEEP",
      "why": "a departed user mailbox connection is swept; provider OAuth-token revoke binds at go-live"
    },
    "connectedInboxes[].workspaceId": {
      "target": "oauthWorkspaces",
      "kind": "scalar-id",
      "policy": "BLOCK",
      "why": "oauthWorkspaceInUse refuses removal while a connected inbox references it (LW-03)"
    },
    "contacts[].companyId": {
      "target": "clients",
      "kind": "scalar-id",
      "policy": "SWEEP",
      "why": "DELETE_CLIENT deletes the company's contacts"
    },
    "contacts[].tagIds": {
      "target": "tags",
      "kind": "id-array",
      "policy": "SWEEP",
      "why": "DELETE_TAG scrubs the tag id"
    },
    "conversations[].clientId": {
      "target": "clients",
      "kind": "scalar-id",
      "policy": "NULLIFY"
    },
    "conversations[].contactId": {
      "target": "contacts",
      "kind": "scalar-id",
      "policy": "NULLIFY"
    },
    "conversations[].createdByUserId": {
      "target": "users",
      "kind": "scalar-id",
      "policy": "NULLIFY+name",
      "nameField": "createdByName",
      "why": "a thread outlives its creator: createdByUserId → null, name demoted to createdByName"
    },
    "conversations[].mutedByUserIds": {
      "target": "users",
      "kind": "id-array",
      "policy": "SWEEP"
    },
    "conversations[].participantUserIds": {
      "target": "users",
      "kind": "id-array",
      "policy": "SWEEP"
    },
    "conversations[].starredByUserIds": {
      "target": "users",
      "kind": "id-array",
      "policy": "SWEEP"
    },
    "invoices[].billingContactId": {
      "target": "contacts",
      "kind": "scalar-id",
      "policy": "NULLIFY"
    },
    "invoices[].clientId": {
      "target": "clients",
      "kind": "scalar-id",
      "policy": "SWEEP"
    },
    "invoices[].jobIds": {
      "target": "jobs",
      "kind": "id-array",
      "policy": "SWEEP",
      "why": "DELETE_JOB scrubs invoice.jobIds"
    },
    "invoices[].siteId": {
      "target": "sites",
      "kind": "scalar-id",
      "policy": "SWEEP",
      "why": "invoice deleted with its client"
    },
    "jobs[].clientId": {
      "target": "clients",
      "kind": "scalar-id",
      "policy": "SWEEP"
    },
    "jobs[].coverFor.{key}": {
      "target": "users",
      "kind": "map-key",
      "policy": "SWEEP",
      "why": "a cover (job.coverFor = { [coverId]: coveredId }, R8) names two users; DELETE_USER scrubs BOTH sides (reducer.js, lib/jobCover.removeUserFromCoverFor). The COVERED cleaner is by definition NOT on the visit, so the crewIds sweep cannot reach them (the cover side)"
    },
    "jobs[].coverFor.{value}": {
      "target": "users",
      "kind": "map-value",
      "policy": "SWEEP",
      "why": "a cover (job.coverFor = { [coverId]: coveredId }, R8) names two users; DELETE_USER scrubs BOTH sides (reducer.js, lib/jobCover.removeUserFromCoverFor). The COVERED cleaner is by definition NOT on the visit, so the crewIds sweep cannot reach them (the covered side)"
    },
    "jobs[].crewIds": {
      "target": "users",
      "kind": "id-array",
      "policy": "SWEEP",
      "why": "DELETE_USER scrubs the user from job crewIds + recurrence dayOverrides + recurrence crewOverride"
    },
    "jobs[].serviceId": {
      "target": "services",
      "kind": "scalar-id",
      "policy": "NULLIFY",
      "why": "DELETE_SERVICE nulls jobs.serviceId"
    },
    "jobs[].siteId": {
      "target": "sites",
      "kind": "scalar-id",
      "policy": "SWEEP",
      "why": "a site dies only via its client, which also deletes the job"
    },
    "keyEvents[].byUserId": {
      "target": "users",
      "policy": "NULLIFY+name",
      "nameField": "byName",
      "why": "key-custody actor demoted to byName on user delete (preserves the legal trail)"
    },
    "keyEvents[].holderUserId": {
      "target": "users",
      "policy": "NULLIFY+name",
      "nameField": "holderName",
      "why": "key-custody holder demoted to holderName on user delete"
    },
    "keyEvents[].keyId": {
      "target": "keys",
      "kind": "scalar-id",
      "policy": "SWEEP",
      "why": "DELETE_KEY deletes the key's events"
    },
    "keys[].clientId": {
      "target": "clients",
      "kind": "scalar-id",
      "policy": "NULLIFY",
      "why": "physical keys outlive the deleted account (custody)",
      "decision": "OQ-01"
    },
    "keys[].heldByUserId": {
      "target": "users",
      "kind": "scalar-id",
      "policy": "NULLIFY+name",
      "nameField": "heldByName",
      "why": "a key out with a deleted user stays out; the holder link is demoted to heldByName so the office still knows who has it"
    },
    "keys[].siteId": {
      "target": "sites",
      "kind": "scalar-id",
      "policy": "NULLIFY",
      "why": "keys survive; siteId nulled with clientId",
      "decision": "OQ-01"
    },
    "marketingEnrollments[].contactId": {
      "target": "contacts",
      "kind": "scalar-id",
      "policy": "SWEEP"
    },
    "marketingEnrollments[].sequenceId": {
      "target": "marketingSequences",
      "kind": "scalar-id",
      "policy": "SWEEP"
    },
    "marketingInboxes[].connectedByUserId": {
      "target": "users",
      "kind": "scalar-id",
      "policy": "NULLIFY"
    },
    "marketingInboxes[].workspaceId": {
      "target": "oauthWorkspaces",
      "kind": "scalar-id",
      "policy": "BLOCK",
      "why": "oauthWorkspaceInUse refuses removal while a marketing inbox references it (LW-03 fix)"
    },
    "marketingReplies[].contactId": {
      "target": "contacts",
      "kind": "scalar-id",
      "policy": "SWEEP"
    },
    "marketingReplies[].enrollmentId": {
      "target": "marketingEnrollments",
      "kind": "scalar-id",
      "policy": "SWEEP"
    },
    "marketingReplies[].fromEmail": {
      "target": "contacts",
      "matchBy": "email",
      "policy": "KEEP-BY-DESIGN",
      "why": "reply email is provenance (like messages.fromEmail); the swept FKs are contactId/enrollmentId. An enrollment-less reply keeps fromEmail after DELETE_CONTACT"
    },
    "marketingReplies[].sequenceId": {
      "target": "marketingSequences",
      "kind": "scalar-id",
      "policy": "SWEEP"
    },
    "marketingSends[].contactId": {
      "target": "contacts",
      "kind": "scalar-id",
      "policy": "SWEEP"
    },
    "marketingSends[].enrollmentId": {
      "target": "marketingEnrollments",
      "kind": "scalar-id",
      "policy": "SWEEP"
    },
    "marketingSends[].inboxId": {
      "target": "marketingInboxes",
      "kind": "scalar-id",
      "policy": "KEEP-BY-DESIGN",
      "why": "records the sending inbox (historical)",
      "decision": "marketing-send-inbox-history"
    },
    "marketingSends[].sequenceId": {
      "target": "marketingSequences",
      "kind": "scalar-id",
      "policy": "SWEEP"
    },
    "marketingSends[].stepId": {
      "target": "marketingSequences.steps",
      "kind": "scalar-id",
      "policy": "KEEP-BY-DESIGN",
      "why": "records which step sent (historical); the live concern is enrollments.currentStepIndex clamping — tracked as an implicit scenario, not an FK cell"
    },
    "marketingSends[].toEmail": {
      "target": "contacts",
      "kind": "scalar-id",
      "policy": "SWEEP",
      "why": "send row deleted with the contact",
      "matchBy": "email"
    },
    "marketingSequences[].createdByUserId": {
      "target": "users",
      "kind": "scalar-id",
      "policy": "NULLIFY"
    },
    "marketingSequences[].notifyOnReplyUserId": {
      "target": "users",
      "kind": "scalar-id",
      "policy": "NULLIFY"
    },
    "marketingSequences[].replyRouting.pipelineId": {
      "target": "pipelines",
      "policy": "NULLIFY",
      "why": "DELETE_PIPELINE clears the routing pipelineId (owner decision)"
    },
    "marketingSettings.replyRouting.pipelineId": {
      "target": "pipelines",
      "policy": "NULLIFY",
      "why": "DELETE_PIPELINE clears the org routing pipelineId"
    },
    "messages[].authorUserId": {
      "target": "users",
      "kind": "scalar-id",
      "policy": "NULLIFY+name",
      "nameField": "authorName",
      "why": "a departed teammate's messages keep their byline: authorUserId → null, name demoted to authorName"
    },
    "messages[].conversationId": {
      "target": "conversations",
      "kind": "scalar-id",
      "policy": "SWEEP",
      "why": "the conversation's messages are deleted with it"
    },
    "messages[].fromEmail": {
      "target": "contacts",
      "kind": "scalar-id",
      "policy": "KEEP-BY-DESIGN",
      "why": "inbound-email provenance (historical address), not a live contact FK",
      "matchBy": "email"
    },
    "messages[].readByUserIds": {
      "target": "users",
      "kind": "id-array",
      "policy": "SWEEP"
    },
    "messages[].snippetId": {
      "target": "snippets",
      "kind": "scalar-id",
      "policy": "KEEP-BY-DESIGN",
      "why": "records which snippet composed the message (historical usage)",
      "decision": "snippet-usage-history"
    },
    "opportunities[].clientId": {
      "target": "clients",
      "kind": "scalar-id",
      "policy": "SWEEP"
    },
    "opportunities[].pipelineId": {
      "target": "pipelines",
      "kind": "scalar-id",
      "policy": "BLOCK",
      "why": "DELETE_PIPELINE refuses while opportunities sit on the pipeline"
    },
    "opportunities[].primaryContactId": {
      "target": "contacts",
      "kind": "scalar-id",
      "policy": "NULLIFY"
    },
    "reminderEvents[].clientId": {
      "target": "clients",
      "kind": "scalar-id",
      "policy": "SWEEP"
    },
    "reminderEvents[].jobId": {
      "target": "jobs",
      "kind": "scalar-id",
      "policy": "SWEEP",
      "why": "scrubbed on DELETE_JOB/SERIES; the UPDATE_JOB_SERIES day-drop path is the suspected miss"
    },
    "sites[].clientId": {
      "target": "clients",
      "kind": "scalar-id",
      "policy": "SWEEP"
    },
    "sites[].siteContactId": {
      "target": "contacts",
      "kind": "scalar-id",
      "policy": "NULLIFY"
    },
    "supplyItems[].clientId": {
      "target": "clients",
      "kind": "scalar-id",
      "policy": "SWEEP",
      "why": "LW-01 fix — lib/deleteCascade.sweepClientOrphans"
    },
    "supplyRequests[].clientId": {
      "target": "clients",
      "kind": "scalar-id",
      "policy": "SWEEP",
      "why": "LW-01 fix"
    },
    "supplyRequests[].completedByUserId": {
      "target": "users",
      "kind": "scalar-id",
      "policy": "NULLIFY+name",
      "nameField": "completedByName",
      "why": "completer link nulled on user delete; the name is kept (completedByName). REOPEN clears it with the id so a later completion is never credited to them"
    },
    "supplyRequests[].lines[].itemId": {
      "target": "supplyItems",
      "kind": "scalar-id",
      "policy": "KEEP-BY-DESIGN",
      "why": "request lines snapshot name+price at request time; itemId is historical (reducer DELETE_SUPPLY_ITEM)"
    },
    "supplyRequests[].requestedByUserId": {
      "target": "users",
      "kind": "scalar-id",
      "policy": "NULLIFY+name",
      "nameField": "requestedByName",
      "why": "requester link nulled on user delete; the name is kept on the request (requestedByName) so Supplies shows who asked instead of \"—\""
    },
    "timeOff[].createdBy": {
      "target": "users",
      "kind": "scalar-id",
      "policy": "NULLIFY"
    },
    "timeOff[].userId": {
      "target": "users",
      "policy": "KEEP-BY-DESIGN",
      "nameField": "userName",
      "why": "a deleted user's PTO/call-out row is kept for historical Reports > Called-out (owner decision) and gains userName so it shows who, not \"—\""
    },
    "timeOff[].scheduledJobIds": {
      "target": "jobs",
      "kind": "id-array",
      "policy": "KEEP-BY-DESIGN",
      "why": "a call-out records the cleans it took the person off at booking (Reports > Called out lists them); the ids are history, and a clean deleted since is simply not listed, so nothing dangles on screen"
    },
    "clients[].crewChecklists.{value}": {
      "target": "checklistTemplates",
      "kind": "map-value",
      "policy": "SWEEP",
      "why": "SCRUB_CHECKLIST_TEMPLATE drops the per-cleaner entry whose template was hard-deleted (removeTemplateFromClients); the cleaner falls back to the account default (decision checklist-template-delete resolved 2026-09-24)"
    },
    "employeeDocuments[].userId": {
      "target": "users",
      "kind": "scalar-id",
      "policy": "SWEEP",
      "why": "an employee's documents go with the employee"
    },
    "inspectionFollowUps[].assigneeUserId": {
      "target": "users",
      "kind": "scalar-id",
      "policy": "NULLIFY"
    },
    "inspectionFollowUps[].inspectionId": {
      "target": "inspections",
      "kind": "scalar-id",
      "policy": "NOT-EXERCISABLE",
