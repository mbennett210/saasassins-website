    },
    "clientActivities[].clientId": {
      "target": "clients",
      "kind": "scalar-id",
      "policy": "SWEEP"
    },
    "contactActivities[].authorUserId": {
      "target": "users",
      "kind": "scalar-id",
      "policy": "NULLIFY+name",
      "nameField": "authorName",
