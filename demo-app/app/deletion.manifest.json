      "decision": "server-side-inspection"
    },
    "inspectionFollowUps[].updatedBy": {
      "target": "users",
      "kind": "scalar-id",
      "policy": "NULLIFY"
    },
    "invitations[].invitedBy": {
      "target": "users",
      "kind": "scalar-id",
      "policy": "NULLIFY"
    },
